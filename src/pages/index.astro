---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

interface Widget {
  title: string;
  url: string;
  image: string;
  alt: string;
  text: string;
}

// Alt innhold på forsiden kommer fra src/data/forside.yaml (CMS: Nettsted → Forsiden).
// Fallback-verdiene under brukes bare hvis yaml-filen mangler felt.
const f = (await getCollection('forside'))[0]?.data;
const site = (await getCollection('nettsted'))[0]?.data?.site;

const hero = {
  kicker: f?.hero?.kicker ?? 'Studentforening ved UiO · Lyd, lys og scene',
  title: f?.hero?.title ?? 'Velkommen til RF-Regi',
  intro:
    f?.hero?.intro ??
    'RF-Regi er en frivillig studentforening ved Universitetet i Oslo som driver med lyd, lys og scene. Vi leier ut utstyr og teknikere til studentforeninger og andre som måtte ha behov for det.',
  ctaPrimary: {
    label: f?.hero?.cta_primary?.label ?? 'Se utleie',
    url: f?.hero?.cta_primary?.url ?? '/utleie/',
  },
  ctaSecondary: {
    label: f?.hero?.cta_secondary?.label ?? 'Bli frivillig',
    url: f?.hero?.cta_secondary?.url ?? '/frivillig/',
  },
};

const widgets: Widget[] = (f?.cards ?? []).map((card) => ({
  title: card.title,
  url: card.url,
  image: card.image,
  alt: card.alt,
  text: card.text,
}));
---

<Base
  title={hero.title}
  description={site?.description ?? 'Nettside for studentforeningen RF-Regi ved Universitetet i Oslo.'}
>
  <section class="hero">
    <div class="wrap">
      <p class="hero-kicker">{hero.kicker}</p>
      <h1>{hero.title}</h1>
      <p>{hero.intro}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={hero.ctaPrimary.url}>{hero.ctaPrimary.label}</a>
        <a class="btn btn-ghost" href={hero.ctaSecondary.url}>{hero.ctaSecondary.label}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>{f?.section_title ?? 'Hva kan vi hjelpe deg med?'}</h2>
      </div>
      <div class="card-grid">
        {
          widgets.map((widget) => (
            <a
              class="card"
              href={widget.url}
              style="color: inherit; text-decoration: none;"
            >
              <img class="card-img" src={widget.image} alt={widget.alt} loading="lazy" />
              <div class="card-body">
                <h3>{widget.title}</h3>
                <p>{widget.text}</p>
                <span class="card-link">{f?.les_mer_tekst ?? 'Les mer'}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
