---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import NetlifyForm from '../components/NetlifyForm.astro';
import EpostLenke from '../components/EpostLenke.astro';

const u = (await getCollection('undersider'))[0]?.data?.kontakt;
const k = {
  title: u?.title ?? 'Kontakt oss',
  teaser: u?.teaser ?? 'Vil du komme i kontakt med oss? Bruk skjemaet eller send oss en mail.',
  generellTittel: u?.generell_tittel ?? 'Generell kontakt',
  generellTekst: u?.generell_tekst ?? '{k.generellTekst}',
  utleieTittel: u?.utleie_tittel ?? 'Utleie',
  utleieTekst: u?.utleie_tekst ?? '{k.utleieTekst}',
};

const styret = (await getCollection('styret')).sort((a, b) => a.data.order - b.data.order);

const fields = [
  { name: 'navn', label: 'Ditt navn', type: 'text' as const, required: true },
  { name: 'email', label: 'Din e-post', type: 'email' as const, required: true },
  { name: 'tekst', label: 'Hva kan vi hjelpe deg med?', type: 'textarea' as const, rows: 6 },
];
---

<Base title={k.title} description={k.teaser}>
  <PageHead title={k.title} teaser={k.teaser} />
  <div class="page-body wrap">
    <div class="prose">
      <NetlifyForm name="contact" fields={fields} submitLabel="Send" />

      <h2>{k.generellTittel}</h2>
      <p>
        {k.generellTekst}
        <EpostLenke encoded="on.igerfr@tsop" />
      </p>

      <h2>{k.utleieTittel}</h2>
      <p>
        {k.utleieTekst}
        <EpostLenke encoded="on.igerfr@eieltu" />
      </p>

      <h2>Styret</h2>
      <ul>
        {
          styret.map((person) => (
            <li>
              {person.data.name} – {person.data.role}:{' '}
              <EpostLenke encoded={person.data.email} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>
